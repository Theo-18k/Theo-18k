<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 360" width="1200" height="360" role="img" aria-labelledby="title desc">
<title id="title">Infrastructure — systems, networks, reliability</title>
<desc id="desc">Bannière professionnelle d’infrastructure IT, fond bleu nuit, topologie réseau abstraite et animations cyan discrètes.</desc>
<defs>
