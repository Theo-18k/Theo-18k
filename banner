  </filter>
  <clipPath id="clip"><rect width="1200" height="360" rx="18"/></clipPath>
  <style>
    @keyframes dataflow { to { stroke-dashoffset:-120 } }
    @keyframes breathe { 0%,100% { opacity:.45 } 50% { opacity:1 } }
    @keyframes sweep { 0% { transform:translateX(-300px); opacity:0 } 15% {opacity:.55} 85% {opacity:.25} 100% {transform:translateX(1250px);opacity:0} }
    @keyframes blink { 0%,45%,100% {opacity:1} 47%,50% {opacity:.2} }
    .flow { stroke-dasharray:7 12; animation:dataflow 4s linear infinite }
    .pulse { animation:breathe 3.5s ease-in-out infinite }
    .sweep { animation:sweep 9s ease-in-out infinite }
    .cursor { animation:blink 1.2s steps(2,end) infinite }
  </style>
</defs>
