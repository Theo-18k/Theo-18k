    <stop offset="0" stop-color="#070C15"/><stop offset=".55" stop-color="#0B1422"/><stop offset="1" stop-color="#101B2A"/>
  </linearGradient>
  <linearGradient id="cyan" x1="0" y1="0" x2="1" y2="0">
    <stop offset="0" stop-color="#38BDF8" stop-opacity=".05"/><stop offset=".5" stop-color="#67E8F9"/><stop offset="1" stop-color="#38BDF8" stop-opacity=".05"/>
  </linearGradient>
  <radialGradient id="halo">
    <stop offset="0" stop-color="#0284C7" stop-opacity=".2"/><stop offset="1" stop-color="#0284C7" stop-opacity="0"/>
  </radialGradient>
  <pattern id="grid" width="32" height="32" patternUnits="userSpaceOnUse">
    <path d="M32 0H0V32" fill="none" stroke="#94A3B8" stroke-opacity=".07" stroke-width="1"/>
